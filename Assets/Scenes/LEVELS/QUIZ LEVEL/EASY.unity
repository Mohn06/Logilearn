  questionNumberText: {fileID: 1969704550}
  scoreEndText: {fileID: 1990603954}
  afterQuizPanel: {fileID: 1056786382}
  correctSound: {fileID: 8300000, guid: 7d62832cb0fd75044ad01cbc31272cb8, type: 3}
  wrongSound: {fileID: 8300000, guid: 9e820b52f9023424c8a95de2f6c8a06a, type: 3}
  buttonSFX: {fileID: 8300000, guid: a38656246b938c24dae2a9725e926b09, type: 3}
  questions:
  - questionText: What does a NOT gate do to its input?
    option1: Keeps it the same
    option2: Doubles it
    option3: Inverts it
    option4: Removes it
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: Which of the following statements best describe a logic gate?
    option1: It is the fundamental building block of a digital circuit.
    option2: Gates can be and OR, an AND, or a NOT
    option3: A circuit with 1 or more input signal but only one output signal.
    option4: The output of a logic gate is either 0 or 1.
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: In digital electronics, the number 1 usually represents what?
    option1: OFF
    option2: 'ON or HIGH signal '
    option3: LOW signal
    option4: Broken signal
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: How many outputs does a basic logic gate usually have?
    option1: One
    option2: Two
    option3: Three
    option4: Unlimited
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: What are the possible output values in digital logic?
    option1: -1 and 1
    option2: 0 and 1
    option3: 1 and 2
    option4: 0 and 2
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: Which gate has only one input?
    option1: AND gate
    option2: OR gate
    option3: NAND gate
    option4: BUFFER gate
    correctAnswer: 4
    questionImage: {fileID: 0}
  - questionText: What type of signals do logic gates process?
    option1: Analog signals
    option2: Digital signals
    option3: Mechanical signals
    option4: Optical signals
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: Which logic gate produces the opposite output of an AND gate?
    option1: NAND
    option2: NOT
    option3: OR
    option4: XOR
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: Which logic gate outputs 1 only when both inputs are 1?
    option1: OR
    option2: AND
    option3: NOT
    option4: XOR
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: Which gate produces 1 only when the inputs are different?
    option1: XOR
    option2: AND
    option3: OR
    option4: NAND
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: What logic gate is shown in the image?
    option1: NAND
    option2: OR
    option3: NOR
    option4: NOT
    correctAnswer: 3
    questionImage: {fileID: 21300000, guid: b56ccd6dbc2caa74da52c90688f157a3, type: 3}
  - questionText: Identify this logic gate
    option1: AND
    option2: OR
    option3: NOT
    option4: NAND
    correctAnswer: 4
    questionImage: {fileID: 21300000, guid: 6afb454b1af415c44a8220ee1ed25a7c, type: 3}
  - questionText: Which gate is known as a universal gate?
    option1: AND
    option2: OR
    option3: NAND
    option4: XOR
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: Which gate behaves like an AND gate followed by a NOT gate?
    option1: NOR
    option2: NAND
    option3: XOR
    option4: OR
    correctAnswer: 2
    questionImage: {fileID: 0}
  delayBeforeNextQuestion: 1
  shuffleQuestions: 1
  maxQuestionsToAsk: 10
  requiredCorrectAnswers: 7
  levelToUnlock: 11
  passMessage: Level unlocked!
  failMessage: You did not get enough correct answers.
