MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1678433286}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3a32680f21afe674782ac7815d959be4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  questionText: {fileID: 1580299913}
  option1Text: {fileID: 703818659}
  option2Text: {fileID: 627139419}
  option3Text: {fileID: 1220233650}
  option4Text: {fileID: 1778244182}
  option1Image: {fileID: 2115777417}
  option2Image: {fileID: 1335039343}
  option3Image: {fileID: 128363434}
  option4Image: {fileID: 274460988}
  questionImageUI: {fileID: 1819804478}
  questionNumberText: {fileID: 1493526230}
  scoreEndText: {fileID: 995607870}
  afterQuizPanel: {fileID: 229290118}
  correctSound: {fileID: 8300000, guid: 7d62832cb0fd75044ad01cbc31272cb8, type: 3}
  wrongSound: {fileID: 8300000, guid: 9e820b52f9023424c8a95de2f6c8a06a, type: 3}
  buttonSFX: {fileID: 8300000, guid: a38656246b938c24dae2a9725e926b09, type: 3}
  questions:
  - questionText: 'A door requires: (1,1) When will it open?'
    option1: If at least one input is 1
    option2: Only when both inputs are 1
    option3: If at least one input is 0
    option4: Only When both inputs are 0
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: A 2-input door requires (1,0). If the outputs are (1,1), what happens?
    option1: Door opens
    option2: Door opens halfway
    option3: Door stays closed
    option4: Door resets
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: 'What is the result of: NOT (A AND B)'
    option1: OR
    option2: XOR
    option3: NOR
    option4: NAND
    correctAnswer: 4
    questionImage: {fileID: 0}
  - questionText: In a broken wire puzzle, even if switches are correct but wire
      is disconnected, what happens?
    option1: The circuit still works because switches are correct
    option2: The output becomes random
    option3: The signal cannot reach the output, so the circuit fails
    option4: The system automatically fixes the wire
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: Which condition makes this true?  (A NOR B) = 1
    option1: (A NOR B) = 1
    option2: A = 1, B = 0
    option3: A = 0, B = 1
    option4: A = 0, B = 0
    correctAnswer: 4
    questionImage: {fileID: 0}
  - questionText: Which circuit will always produce 0?
    option1: A AND 0
    option2: NOT 0
    option3: A OR 0
    option4: A XOR 0
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: 'What is the output of: (A XOR B) AND (C OR D) if A=1, B=0, C=0,
      D=1?'
    option1: 1
    option2: 0
    option3: 0 only if A is 0
    option4: 1 only if D is 0
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: Which circuit will always produce 1?
    option1: A AND 0
    option2: A AND NOT A
    option3: A OR NOT A
    option4: A XOR B
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: "A player connects all wires correctly, but the door still won\u2019t
      open. What is the MOST likely reason?"
    option1: The wires are too long
    option2: The gates are broken
    option3: The switches are in the wrong states
    option4: The door needs two inputs only
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: In a circuit, both inputs of a NOR gate are ON. What is the output?
    option1: 1
    option2: 0
    option3: It stays unchanged
    option4: It alternates
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: Which situation will ALWAYS make an XOR gate output 0?
    option1: Inputs are different
    option2: Both inputs are OFF
    option3: Both inputs are the same
    option4: One input is ON
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: A player wants a gate to output 1 only when both inputs are equal.
      Which gate should they use?
    option1: XOR
    option2: XNOR
    option3: NAND
    option4: NOR
    correctAnswer: 2
    questionImage: {fileID: 0}
  - questionText: Which gate will turn a 1 into a 0 and a 0 into a 1?
    option1: AND
    option2: OR
    option3: NOT
    option4: XOR
    correctAnswer: 3
    questionImage: {fileID: 0}
  - questionText: A 2-input door requires (1,1). The player gets (1,1). What is the
      result?
    option1: Door opens
    option2: Door partially opens
    option3: Door stays closed
    option4: Door resets
    correctAnswer: 1
    questionImage: {fileID: 0}
  - questionText: A player connects a circuit correctly, but flips one switch from
      OFF to ON and the output becomes 0. What does this suggest?
    option1: The circuit uses AND logic
    option2: The circuit uses OR logic
    option3: The circuit uses NOT logic
    option4: The circuit ignores switches
    correctAnswer: 1
    questionImage: {fileID: 0}
