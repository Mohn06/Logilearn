  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleTutorialPopupTrigger2D
  pages:
  - title: Switch
    description: A Switch is an input device. It sends signals to the circuit. An
      Input is a signal sent into a circuit or logic gate. It can be 0 (OFF) or 1
      (ON).
    image: {fileID: 21300000, guid: abbc642f54477e046ac13cc3fb4ea1a5, type: 3}
  - title: Interact Button
    description: Use the Interact Button to activate switches and other interactable
      objects
    image: {fileID: 21300000, guid: 4c694ef032705dc4b8758d8d3b376324, type: 3}
  - title: Wire
    description: Wires connect components in the circuit. It delivers the signals
      from the source to it's target
    image: {fileID: 21300000, guid: b53bf9e485c4beb488bc32426523da8f, type: 3}
  - title: Door
    description: The Door opens only when the correct Input signal is produced.
    image: {fileID: 21300000, guid: 1d6c00ac2fccb4d4ea5360601466a5cd, type: 3}
  - title: Input Indicator
    description: The Input Indicator shows the signal needed to open the door.
    image: {fileID: 21300000, guid: 10be3e5e25bebc7408f8317f90e22731, type: 3}
