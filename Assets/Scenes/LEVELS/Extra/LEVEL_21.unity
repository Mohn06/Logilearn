  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleTutorialPopupTrigger2D
  pages:
  - title: Check the Code
    description: 'Inspect the Arduino code on the panel.

      Ensure all wires
      are properly connected and each pin is placed correctly.'
    image: {fileID: 21300000, guid: cd7e307bd475a584c9bc2b53b0c91a4b, type: 3}
  - title: Power Source
    description: 'Connect the battery to the Arduino properly.

      Make sure to
      connect the possivite is connected to 5V and negative to Ground(GND).'
    image: {fileID: 21300000, guid: 2d58172b2516e05478874e05745b30c8, type: 3}
  - title: LED Connection
    description: Connect the LED to the correct pin and ground. The longer leg is
      the possitive and the shorter one is negative.
    image: {fileID: 21300000, guid: d02870602a2f36e4f8804d7d6ed06652, type: 3}
  - title: Resistor
    description: 'Check the resistor placement in the circuit.

      Ensure it is
      properly connected to limit the current flowing to the LED.'
    image: {fileID: 21300000, guid: 4fb515474f576694489160b6076c74c9, type: 3}
  - title: Complete the Circuit
    description: Complete the circuit correctly base on the code provided and tap
      submit to turn the power back on.
    image: {fileID: 21300000, guid: 6d608a19d8e36cc48a14bf8a67d64e45, type: 3}
